    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "instances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"instances\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"service_type\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"auth_kind\" TEXT NOT NULL, \"auth_failed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"auth_failed\" IN (0, 1)), \"cert_pin\" TEXT NULL, \"custom_ca\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"detected_version\" TEXT NULL, \"last_probe\" TEXT NULL, \"unsupported_version\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "instance_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"instance_links\" (\"instance_id\" TEXT NOT NULL REFERENCES instances (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"target_instance_id\" TEXT NOT NULL REFERENCES instances (id) ON DELETE CASCADE, PRIMARY KEY (\"instance_id\", \"type\", \"target_instance_id\"));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"active_profile_id\" TEXT NULL REFERENCES profiles (id) ON DELETE SET NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"true_black\" INTEGER NOT NULL DEFAULT 0 CHECK (\"true_black\" IN (0, 1)), \"dynamic_color\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dynamic_color\" IN (0, 1)), \"load_third_party_artwork\" INTEGER NOT NULL DEFAULT 1 CHECK (\"load_third_party_artwork\" IN (0, 1)), \"app_lock_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"app_lock_enabled\" IN (0, 1)), \"app_lock_delay_seconds\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (id = 0)) WITHOUT ROWID;"
        }
      ]
    },
    {
      "name": "view_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"view_preferences\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"library\" TEXT NOT NULL, \"layout\" TEXT NOT NULL, \"sort\" TEXT NOT NULL, \"filters\" TEXT NOT NULL, \"instance_scope\" TEXT NULL, PRIMARY KEY (\"profile_id\", \"library\"));"
